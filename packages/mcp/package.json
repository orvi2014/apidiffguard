{
  "name": "@apidiffguard/mcp",
  "version": "0.1.0",
  "description": "MCP server for APIDiffGuard — let coding agents read what an API actually returns and what changed.",
  "type": "module",
  "bin": {
    "apidiffguard-mcp": "bin/apidiffguard-mcp.js"
  },
  "exports": {
    ".": "./src/server.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/apidiffguard-mcp.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@apidiffguard/diff": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "api",
    "json-schema",
    "breaking-change",
    "agents",
    "apidiffguard"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orvi2014/apidiffguard.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://apidiffguard.com/docs/mcp",
  "bugs": {
    "url": "https://github.com/orvi2014/apidiffguard/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
