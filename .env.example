# Supabase (required for auth + data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres (migrations)
DATABASE_URL=
DIRECT_URL=

# Trust x-forwarded-for for rate-limit bucketing. Auto-on when VERCEL is set.
# Set to 1 only if a proxy you control overwrites the header; otherwise it is spoofable.
TRUST_PROXY_HEADERS=

# App URL (production: https://your-domain.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protects /api/cron/schedules (Vercel Cron or GitHub Actions). Required for scheduled checks.
CRON_SECRET=

# Encrypts endpoint credentials (bearer tokens, API keys, basic-auth passwords)
# before they are written to the database. Required to save any endpoint that
# uses authentication. 32 bytes, base64 or hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes existing stored credentials unreadable — they must be
# re-entered.
ENDPOINT_SECRET_KEY=

# Stripe (Checkout + Customer Portal + webhooks)
# Create Prices with lookup keys: apidiffguard_starter_monthly, apidiffguard_pro_monthly
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email alert channel. Both are required before the Email option appears in the
# channel picker; without them, alerts fall back to Slack/Discord/webhooks.
# ALERT_FROM_EMAIL must be on a domain verified in Resend.
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# Optional integrations (not required for local MVP)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TRIGGER_SECRET_KEY=
